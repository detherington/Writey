// Committed default config — safe to be public.
//
// Values that must NOT be committed (real OAuth client ID, etc.) live in
// `Secrets.xcconfig` next to this file. That file is gitignored. The
// optional `#include?` at the bottom lets the project build cleanly even
// when Secrets.xcconfig doesn't exist — features that depend on real
// credentials just degrade gracefully (e.g. Google sign-in stays disabled).

// MARK: - Google OAuth
// Empty by default. Override in Secrets.xcconfig with your real values:
//   OAUTH_CLIENT_ID = 1234567890-xxxxx.apps.googleusercontent.com
//   OAUTH_REDIRECT_SCHEME = com.googleusercontent.apps.1234567890-xxxxx
OAUTH_CLIENT_ID =
OAUTH_REDIRECT_SCHEME = com.writey.Writey

// MARK: - Sparkle auto-update
// SU_PUBLIC_ED_KEY is a *verification* key — safe and required to be public.
// The matching private signing key lives ONLY in your macOS Keychain
// locally, and as a GitHub Actions secret named SPARKLE_PRIVATE_KEY in CI.
SU_FEED_URL = https://github.com/detherington/Writey/releases/latest/download/appcast.xml
SU_PUBLIC_ED_KEY = ODjAca9kR1OJ8SuY35WtdhSjO7BM+sPltxEVWNBjqyo=

// Pull in real values if present. The `?` makes the include optional.
#include? "Secrets.xcconfig"
