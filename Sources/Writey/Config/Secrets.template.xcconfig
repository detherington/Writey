// COPY THIS FILE to `Secrets.xcconfig` (no `.template`) and fill in your
// real values. `Secrets.xcconfig` is gitignored — it never gets committed.
//
//   cp Sources/Writey/Config/Secrets.template.xcconfig \
//      Sources/Writey/Config/Secrets.xcconfig
//   # then edit Secrets.xcconfig
//
// After editing, regenerate the Xcode project so it picks up the new
// config file: `xcodegen generate`.

OAUTH_CLIENT_ID = REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
OAUTH_REDIRECT_SCHEME = com.googleusercontent.apps.REPLACE_WITH_YOUR_CLIENT_ID
